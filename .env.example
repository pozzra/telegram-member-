# ============================================================
# Telegram Adder Web Pro - Configuration
# ============================================================
# Copy this file to .env and fill in your values

# --- Telegram License Bot ---
# Get your bot token from @BotFather on Telegram
BOT_TOKEN=1234567890:ABCdefGhiJklMnoPqrStuVwxYz

# (Optional) Pre-set admin chat ID - bot will also auto-detect
# when admin sends /start. Get your chat ID via @userinfobot
ADMIN_CHAT_ID=

# --- Telegram account login (optional) ---
# Default country code used for local phone numbers (e.g. 017271771).
DEFAULT_COUNTRY_CODE=855

# Recommended: use your own API ID/hash from https://my.telegram.org/apps.
# The dashboard has built-in fallbacks, but shared credentials can hit
# Telegram flood limits.
# TELEGRAM_API_ID=12345678
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# --- License revocation sync ---
# Central license server (the Render backend). Revocations made in the bot are
# pushed here; the hosted site and bot pull from here on every verification.
# Leave EMPTY on the Render backend itself (it owns the authoritative list).
LICENSE_API_BASE=https://telegram-adder-web.onrender.com

# How often (seconds) to re-pull the revoked list from the central server.
REVOKED_SYNC_TTL=30

# HTTP timeout (seconds) for revocation sync calls.
REVOKED_SYNC_TIMEOUT=3

# Master key for the license admin API (must match across bot and server).
# ADMIN_MASTER_KEY=kun_amra_admin_2026

